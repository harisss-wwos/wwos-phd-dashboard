# Copy to .env for local dev, or set these as environment variables in Render.
# NEVER commit the real .env file.

# MongoDB Atlas connection string (from Atlas -> Connect -> Drivers).
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"

# Database name to use (kept separate from Atlas sample data).
MONGODB_DB="phd"

# Secret for signing JWTs. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: token lifetime (default 12h).
JWT_TTL="12h"

# Comma-separated list of allowed browser origins (the static site).
# Defaults to the GitHub Pages site + localhost if unset.
ALLOWED_ORIGINS="https://harisss-wwos.github.io,http://127.0.0.1:8082"

# Optional: override seed passwords instead of the built-in defaults.
# SEED_HARISSS_PW=""
# SEED_ARUNKZN_PW=""
# SEED_FLOFALGU_PW=""
# SEED_PUNITHSD_PW=""
